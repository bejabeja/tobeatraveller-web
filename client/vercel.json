{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://tfm-eta.vercel.app/sitemap.xml"
        },
        {
            "source": "/profile/:id/passport",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "https://tfm-eta.vercel.app/og/passport/:id"
        },
        {
            "source": "/itinerary/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "https://tfm-eta.vercel.app/og/itinerary/:id"
        },
        {
            "source": "/profile/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "https://tfm-eta.vercel.app/og/profile/:id"
        },
        {
            "source": "/friend-profile/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "https://tfm-eta.vercel.app/og/profile/:id"
        },
        {
            "source": "/@:username",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "https://tfm-eta.vercel.app/og/user/:username"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'none'"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}
