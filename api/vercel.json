{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.js"
        }
    ],
    "crons": [
        {
            "path": "/audit-log/scheduled-purge",
            "schedule": "0 3 1 * *"
        },
        {
            "path": "/push-tokens/scheduled-purge",
            "schedule": "0 4 * * *"
        },
        {
            "path": "/recap/scheduled-announce",
            "schedule": "0 9 1 12 *"
        },
        {
            "path": "/badges/scheduled-evaluate",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/referrals/scheduled-purge",
            "schedule": "0 5 * * *"
        },
        {
            "path": "/packing-checklist/scheduled-remind",
            "schedule": "0 8 * * *"
        }
    ]
}
