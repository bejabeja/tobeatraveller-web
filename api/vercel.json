{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.js"
        }
    ],
    "crons": [
        {
            "path": "/audit-log/scheduled-purge",
            "schedule": "0 3 1 * *"
        },
        {
            "path": "/push-tokens/scheduled-purge",
            "schedule": "0 4 * * *"
        }
    ]
}